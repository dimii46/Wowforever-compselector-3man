<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WoW Forever Comp Selector</title>
<style>
:root{--bg:#07101c;--panel:#111d2c;--panel2:#19283b;--border:#38506c;--text:#f4f7fb;--muted:#a8b7c9;--gold:#f5c451;--tank:#438de8;--heal:#48bc72;--dps:#df5959;--good:#65dc90;--bad:#ff7b7b}
*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:30px 16px;font-family:Arial,sans-serif;color:var(--text);background:radial-gradient(circle at top,#274264 0,#07101c 55%,#02070d 100%)}
.container{max-width:1120px;margin:auto}.header{text-align:center;margin-bottom:24px}.header small{color:var(--gold);letter-spacing:3px;font-weight:700}.header h1{margin:8px 0;font-size:clamp(30px,5vw,48px)}.header p{color:var(--muted);line-height:1.6;max-width:780px;margin:auto}
.main{background:rgba(17,29,44,.97);border:1px solid var(--border);border-radius:20px;padding:24px;box-shadow:0 18px 50px #0008}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.role{background:var(--panel2);border:1px solid var(--border);border-top:4px solid;border-radius:14px;padding:18px}.role.tank{border-top-color:var(--tank)}.role.healer{border-top-color:var(--heal)}.role.dps{border-top-color:var(--dps)}label{display:block;font-weight:700;margin-bottom:10px}select{width:100%;padding:12px;border-radius:8px;border:1px solid #58718f;background:#08131f;color:white;font-size:15px}select:disabled{opacity:.5}.armor{color:var(--muted);font-size:14px;margin-top:10px;min-height:18px}
.status{margin-top:20px;padding:16px;text-align:center;background:#08131f;border:1px solid var(--border);border-radius:12px;color:var(--muted)}.status.good{border-color:#347e50;color:var(--good)}.status.bad{border-color:#954646;color:var(--bad)}.buttons{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:20px}button{padding:12px 18px;border:0;border-radius:9px;background:var(--gold);color:#111;font-weight:700;cursor:pointer}button.secondary{background:#223650;color:white;border:1px solid #59718d}button:hover{filter:brightness(1.08)}
.results{display:none;margin-top:20px}.results.show{display:block}.score{display:grid;grid-template-columns:150px 1fr;gap:22px;align-items:center;background:#08131f;border:1px solid var(--border);border-radius:14px;padding:20px}.circle{width:130px;height:130px;border:7px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;margin:auto}.circle b{font-size:38px}.circle span{font-size:12px;color:var(--muted)}.score h2{margin:0 0 8px;color:var(--gold)}.stars{color:var(--gold);font-size:25px;letter-spacing:3px}.score p{color:var(--muted);line-height:1.5}
.details{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:16px}.card{background:var(--panel2);border:1px solid var(--border);border-radius:14px;padding:18px}.card h3{margin:0 0 12px;color:var(--gold)}ul{list-style:none;margin:0;padding:0}li{background:#08131f;margin-bottom:8px;padding:9px;border-radius:7px;line-height:1.4}.badge{display:inline-block;padding:3px 6px;border-radius:5px;color:#08131f;font-size:11px;font-weight:700;margin-right:6px}.primary{background:#c278ff}.emergency{background:#ff7777}.interrupt{background:#5cbcff}.conditional{background:#f4bd54}.soft{background:#63d0a3}.utility{background:#aebed0}.bars{display:grid;gap:9px}.barrow{display:grid;grid-template-columns:120px 1fr 48px;gap:8px;align-items:center;font-size:13px}.bar{height:9px;background:#06101a;border-radius:99px;overflow:hidden}.fill{height:100%;background:var(--gold)}
@media(max-width:800px){.grid,.details{grid-template-columns:1fr}.score{grid-template-columns:1fr;text-align:center}}@media(max-width:500px){.main{padding:16px}.buttons button{width:100%}}
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <small>PVE DUNGEON PARTY BUILDER</small>
    <h1>WoW Forever Comp Selector</h1>
    <p>Choose a tank first. Then choose either healer or DPS. The remaining list is filtered so all three characters use different armor types.</p>
  </div>
  <main class="main">
    <div class="grid">
      <div class="role tank"><label for="tank">Tank</label><select id="tank"><option value="">Select Tank</option></select><div class="armor" id="tankArmor">No profile selected</div></div>
      <div class="role healer"><label for="healer">Healer</label><select id="healer" disabled><option value="">Select Healer</option></select><div class="armor" id="healerArmor">Select a tank first</div></div>
      <div class="role dps"><label for="dps">DPS</label><select id="dps" disabled><option value="">Select DPS</option></select><div class="armor" id="dpsArmor">Select a tank first</div></div>
    </div>
    <div class="status" id="status">Select a tank to begin.</div>
    <div class="results" id="results">
      <div class="score">
        <div class="circle" id="circle"><b id="score">0</b><span>OUT OF 100</span></div>
        <div><h2 id="rating">Dungeon Synergy</h2><div class="stars" id="stars">☆☆☆☆☆</div><p id="description"></p></div>
      </div>
      <div class="details">
        <div class="card"><h3>Score Breakdown</h3><div class="bars" id="breakdown"></div></div>
        <div class="card"><h3>Armor Distribution</h3><ul id="armorList"></ul></div>
        <div class="card"><h3>Primary Hard CC</h3><ul id="primaryList"></ul></div>
        <div class="card"><h3>Emergency Hard CC</h3><ul id="emergencyList"></ul></div>
        <div class="card"><h3>Reliable Interrupts</h3><ul id="interruptList"></ul></div>
        <div class="card"><h3>Conditional CC</h3><ul id="conditionalList"></ul></div>
        <div class="card"><h3>Soft Control</h3><ul id="softList"></ul></div>
        <div class="card"><h3>Utility</h3><ul id="utilityList"></ul></div>
      </div>
    </div>
    <div class="buttons"><button type="button" id="randomButton">Random Valid Comp</button><button type="button" class="secondary" id="resetButton">Reset Composition</button></div>
  </main>
</div>
<script>
(function(){
'use strict';
const P={
 wp:{name:'Warrior - Protection',cls:'Warrior',role:'Tank',armor:'Plate',primary:[],emergency:['Intimidating Shout'],interrupt:['Shield Bash','Pummel'],conditional:[],soft:['Hamstring','Disarm'],utility:['Battle Shout','Demoralizing Shout','Sunder Armor']},
 pp:{name:'Paladin - Protection',cls:'Paladin',role:'Tank',armor:'Plate',primary:[],emergency:['Hammer of Justice'],interrupt:[],conditional:['Turn Undead - Undead only'],soft:['Judgement of Justice'],utility:['Cleanse','Blessing of Freedom','Blessing of Protection','Auras']},
 dt:{name:'Druid - Feral Tank',cls:'Druid',role:'Tank',armor:'Leather',primary:[],emergency:['Bash'],interrupt:['Feral Charge'],conditional:['Hibernate - Beasts and Dragonkin','Entangling Roots - situational'],soft:['Entangling Roots','Nature\'s Grasp'],utility:['Mark of the Wild','Faerie Fire - debuff, not CC','Rebirth']},
 ph:{name:'Priest - Holy',cls:'Priest',role:'Healer',armor:'Cloth',primary:[],emergency:['Psychic Scream'],interrupt:[],conditional:['Shackle Undead - Undead only'],soft:[],utility:['Dispel Magic','Abolish Disease','Power Word: Fortitude','Power Word: Shield','Fear Ward']},
 pd:{name:'Priest - Discipline',cls:'Priest',role:'Healer',armor:'Cloth',primary:[],emergency:['Psychic Scream'],interrupt:[],conditional:['Shackle Undead - Undead only'],soft:[],utility:['Dispel Magic','Abolish Disease','Power Word: Fortitude','Power Word: Shield','Penance']},
 hp:{name:'Paladin - Holy',cls:'Paladin',role:'Healer',armor:'Plate',primary:[],emergency:['Hammer of Justice'],interrupt:[],conditional:['Turn Undead - Undead only'],soft:['Judgement of Justice'],utility:['Cleanse','Purify','Blessing of Freedom','Blessing of Protection','Lay on Hands']},
 sr:{name:'Shaman - Restoration',cls:'Shaman',role:'Healer',armor:'Mail',primary:[],emergency:[],interrupt:['Earth Shock'],conditional:['Stoneclaw Totem - situational'],soft:['Earthbind Totem','Frost Shock'],utility:['Tremor Totem','Grounding Totem','Cure Poison','Cure Disease','Purge','Reincarnation']},
 dr:{name:'Druid - Restoration',cls:'Druid',role:'Healer',armor:'Leather',primary:[],emergency:['Bash - Bear Form and melee'],interrupt:[],conditional:['Hibernate - Beasts and Dragonkin','Entangling Roots - situational'],soft:['Entangling Roots','Nature\'s Grasp'],utility:['Remove Curse','Abolish Poison','Mark of the Wild','Rebirth','Innervate']},
 ma:{name:'Mage - Arcane',cls:'Mage',role:'DPS',armor:'Cloth',primary:['Polymorph'],emergency:['Frost Nova'],interrupt:['Counterspell'],conditional:[],soft:['Frostbolt','Cone of Cold'],utility:['Arcane Intellect','Remove Lesser Curse','Food and Water']},
 mf:{name:'Mage - Fire',cls:'Mage',role:'DPS',armor:'Cloth',primary:['Polymorph'],emergency:['Frost Nova'],interrupt:['Counterspell'],conditional:[],soft:['Frostbolt','Cone of Cold'],utility:['Arcane Intellect','Remove Lesser Curse','Food and Water']},
 mz:{name:'Mage - Frost',cls:'Mage',role:'DPS',armor:'Cloth',primary:['Polymorph'],emergency:['Frost Nova'],interrupt:['Counterspell'],conditional:[],soft:['Frostbolt','Cone of Cold','Improved Blizzard'],utility:['Arcane Intellect','Remove Lesser Curse','Food and Water']},
 wa:{name:'Warlock - Affliction',cls:'Warlock',role:'DPS',armor:'Cloth',primary:['Fear','Banish'],emergency:[],interrupt:[],conditional:['Seduction - Succubus/Incubus','Spell Lock - Felhunter'],soft:['Curse of Exhaustion - talent'],utility:['Healthstone','Soulstone','Curses','Devour Magic - Felhunter']},
 wd:{name:'Warlock - Demonology',cls:'Warlock',role:'DPS',armor:'Cloth',primary:['Fear','Banish'],emergency:[],interrupt:[],conditional:['Seduction - Succubus/Incubus','Spell Lock - Felhunter'],soft:[],utility:['Healthstone','Soulstone','Curses','Devour Magic - Felhunter']},
 wx:{name:'Warlock - Destruction',cls:'Warlock',role:'DPS',armor:'Cloth',primary:['Fear','Banish'],emergency:[],interrupt:[],conditional:['Seduction - Succubus/Incubus','Spell Lock - Felhunter'],soft:[],utility:['Healthstone','Soulstone','Curses','Devour Magic - Felhunter']},
 ps:{name:'Priest - Shadow',cls:'Priest',role:'DPS',armor:'Cloth',primary:[],emergency:['Psychic Scream'],interrupt:['Silence - Shadow build'],conditional:['Shackle Undead - Undead only','Mind Control - situational humanoid'],soft:['Mind Flay - Shadow build'],utility:['Dispel Magic','Abolish Disease','Power Word: Fortitude']},
 rc:{name:'Rogue - Combat',cls:'Rogue',role:'DPS',armor:'Leather',primary:['Sap'],emergency:['Cheap Shot','Kidney Shot','Gouge','Blind'],interrupt:['Kick'],conditional:['Sap - valid out-of-combat target'],soft:['Crippling Poison'],utility:['Distract','Vanish','Lockpicking']},
 rd:{name:'Rogue - Subtlety',cls:'Rogue',role:'DPS',armor:'Leather',primary:['Sap'],emergency:['Cheap Shot','Kidney Shot','Gouge','Blind'],interrupt:['Kick'],conditional:['Sap - valid out-of-combat target'],soft:['Crippling Poison'],utility:['Distract','Vanish','Lockpicking']},
 df:{name:'Druid - Feral DPS',cls:'Druid',role:'DPS',armor:'Leather',primary:[],emergency:['Pounce','Bash'],interrupt:['Feral Charge'],conditional:['Hibernate - Beasts and Dragonkin','Entangling Roots - situational'],soft:['Entangling Roots','Nature\'s Grasp'],utility:['Mark of the Wild','Faerie Fire - debuff, not CC','Rebirth']},
 db:{name:'Druid - Balance',cls:'Druid',role:'DPS',armor:'Leather',primary:[],emergency:['Bash - Bear Form and melee'],interrupt:[],conditional:['Hibernate - Beasts and Dragonkin','Entangling Roots - situational'],soft:['Entangling Roots','Nature\'s Grasp'],utility:['Mark of the Wild','Faerie Fire - debuff, not CC','Rebirth','Innervate']},
 hb:{name:'Hunter - Beast Mastery',cls:'Hunter',role:'DPS',armor:'Mail',primary:['Freezing Trap'],emergency:['Intimidation - talent'],interrupt:[],conditional:['Pet control - depends on active pet'],soft:['Concussive Shot','Wing Clip','Frost Trap'],utility:['Tranquilizing Shot','Flare','Hunter\'s Mark','Pet utility']},
 hm:{name:'Hunter - Marksmanship',cls:'Hunter',role:'DPS',armor:'Mail',primary:['Freezing Trap'],emergency:['Scatter Shot - build'],interrupt:[],conditional:['Pet control - depends on active pet'],soft:['Concussive Shot','Wing Clip','Frost Trap'],utility:['Tranquilizing Shot','Flare','Hunter\'s Mark','Pet utility']},
 hs:{name:'Hunter - Survival',cls:'Hunter',role:'DPS',armor:'Mail',primary:['Freezing Trap'],emergency:['Wyvern Sting - build'],interrupt:[],conditional:['Pet control - depends on active pet'],soft:['Concussive Shot','Wing Clip','Frost Trap'],utility:['Tranquilizing Shot','Flare','Hunter\'s Mark','Pet utility']},
 se:{name:'Shaman - Elemental',cls:'Shaman',role:'DPS',armor:'Mail',primary:[],emergency:[],interrupt:['Earth Shock'],conditional:['Stoneclaw Totem - situational'],soft:['Earthbind Totem','Frost Shock'],utility:['Purge','Tremor Totem','Grounding Totem','Cure Poison','Cure Disease']},
 sh:{name:'Shaman - Enhancement',cls:'Shaman',role:'DPS',armor:'Mail',primary:[],emergency:[],interrupt:['Earth Shock'],conditional:['Stoneclaw Totem - situational'],soft:['Earthbind Totem','Frost Shock'],utility:['Purge','Tremor Totem','Grounding Totem','Windfury Totem']},
 war:{name:'Warrior - Arms',cls:'Warrior',role:'DPS',armor:'Plate',primary:[],emergency:['Intimidating Shout'],interrupt:['Pummel','Shield Bash - shield required'],conditional:[],soft:['Hamstring','Disarm'],utility:['Battle Shout','Demoralizing Shout','Sunder Armor']},
 wf:{name:'Warrior - Fury',cls:'Warrior',role:'DPS',armor:'Plate',primary:[],emergency:['Intimidating Shout'],interrupt:['Pummel','Shield Bash - shield required'],conditional:[],soft:['Hamstring','Disarm'],utility:['Battle Shout','Demoralizing Shout','Sunder Armor']},
 pr:{name:'Paladin - Retribution',cls:'Paladin',role:'DPS',armor:'Plate',primary:[],emergency:['Hammer of Justice'],interrupt:[],conditional:['Turn Undead - Undead only'],soft:['Judgement of Justice'],utility:['Cleanse','Blessing of Freedom','Blessing of Protection','Auras']}
};
const roles={Tank:['wp','pp','dt'],Healer:['ph','pd','hp','sr','dr'],DPS:['ma','mf','mz','wa','wd','wx','ps','rc','rd','df','db','hb','hm','hs','se','sh','war','wf','pr']};
const $=id=>document.getElementById(id);const tank=$('tank'),healer=$('healer'),dps=$('dps');
function fill(el,ids,label,keep){el.innerHTML='<option value="">'+label+'</option>';ids.forEach(id=>{const o=document.createElement('option');o.value=id;o.textContent=P[id].name+' ('+P[id].armor+')';el.appendChild(o)});el.value=ids.includes(keep)?keep:''}
function available(role,t,h,d){const used=[];if(role!=='Tank'&&t)used.push(P[t].armor);if(role!=='Healer'&&h)used.push(P[h].armor);if(role!=='DPS'&&d)used.push(P[d].armor);return roles[role].filter(id=>!used.includes(P[id].armor))}
function dropdowns(){if(!tank.value){fill(healer,[],'Select Healer','');fill(dps,[],'Select DPS','');healer.disabled=true;dps.disabled=true;return}healer.disabled=false;dps.disabled=false;let h=healer.value,d=dps.value;fill(healer,available('Healer',tank.value,'',d),'Select Healer',h);h=healer.value;fill(dps,available('DPS',tank.value,h,''),'Select DPS',d)}
function armor(el,id,msg){el.textContent=id?P[id].cls+' - '+P[id].armor+' armor':msg}
function collect(ids,key){const a=[];ids.forEach(id=>P[id][key].forEach(x=>a.push({who:P[id].name,text:x})));return a}
function calc(t,h,d){const ids=[t,h,d],x={primary:collect(ids,'primary'),emergency:collect(ids,'emergency'),interrupt:collect(ids,'interrupt'),conditional:collect(ids,'conditional'),soft:collect(ids,'soft'),utility:collect(ids,'utility')};x.parts={armor:25,primary:Math.min(20,x.primary.length*10),emergency:Math.min(10,x.emergency.length*4),interrupt:Math.min(20,x.interrupt.length*10),conditional:Math.min(8,x.conditional.length*3),soft:Math.min(6,x.soft.length*2),utility:Math.min(11,x.utility.length)};x.total=Object.values(x.parts).reduce((a,b)=>a+b,0);return x}
function list(el,items,kind,empty){el.innerHTML='';if(!items.length){el.innerHTML='<li><span class="badge '+kind+'">NONE</span>'+empty+'</li>';return}items.forEach(x=>{const li=document.createElement('li');li.innerHTML='<span class="badge '+kind+'">'+kind.toUpperCase()+'</span><strong>'+x.who+':</strong> '+x.text;el.appendChild(li)})}
function bars(parts){const defs=[['Armor','armor',25],['Primary CC','primary',20],['Emergency CC','emergency',10],['Interrupts','interrupt',20],['Conditional CC','conditional',8],['Soft Control','soft',6],['Utility','utility',11]];$('breakdown').innerHTML='';defs.forEach(([n,k,m])=>{$('breakdown').insertAdjacentHTML('beforeend','<div class="barrow"><span>'+n+'</span><div class="bar"><div class="fill" style="width:'+(parts[k]/m*100)+'%"></div></div><span>'+parts[k]+'/'+m+'</span></div>')})}
function showResult(t,h,d){const r=calc(t,h,d);$('results').classList.add('show');$('score').textContent=r.total;let title,desc,s,c;if(r.total>=90){title='Exceptional Dungeon Synergy';desc='Excellent armor distribution, control, interrupts and utility.';s=5;c='#65dc90'}else if(r.total>=75){title='Strong Dungeon Synergy';desc='Strong control and utility for dangerous dungeon pulls.';s=4;c='#9edb6e'}else if(r.total>=60){title='Good Dungeon Synergy';desc='Capable, but missing one or two important coverage categories.';s=3;c='#f5c451'}else if(r.total>=45){title='Average Dungeon Synergy';desc='Playable, with noticeable gaps in reliable CC or interrupts.';s=2;c='#e89445'}else{title='Limited Dungeon Synergy';desc='Valid armor spread, but limited control and utility.';s=1;c='#df5959'}$('rating').textContent=title;$('description').textContent=desc;$('stars').textContent='★'.repeat(s)+'☆'.repeat(5-s);$('circle').style.borderColor=c;bars(r.parts);$('armorList').innerHTML='<li><strong>Tank:</strong> '+P[t].name+' - '+P[t].armor+'</li><li><strong>Healer:</strong> '+P[h].name+' - '+P[h].armor+'</li><li><strong>DPS:</strong> '+P[d].name+' - '+P[d].armor+'</li><li>No armor overlap</li>';list($('primaryList'),r.primary,'primary','No primary hard CC.');list($('emergencyList'),r.emergency,'emergency','No emergency hard CC.');list($('interruptList'),r.interrupt,'interrupt','No reliable interrupt.');list($('conditionalList'),r.conditional,'conditional','No conditional CC.');list($('softList'),r.soft,'soft','No soft control.');list($('utilityList'),r.utility,'utility','No extra utility.')}
function update(){armor($('tankArmor'),tank.value,'No profile selected');armor($('healerArmor'),healer.value,tank.value?'No profile selected':'Select a tank first');armor($('dpsArmor'),dps.value,tank.value?'No profile selected':'Select a tank first');const st=$('status');st.className='status';$('results').classList.remove('show');if(!tank.value){st.textContent='Select a tank to begin.';return}if(!healer.value&&!dps.value){st.textContent=P[tank.value].name+' selected. Choose a healer or DPS.';return}if(healer.value&&!dps.value){st.textContent=P[tank.value].name+' and '+P[healer.value].name+' selected. Choose a DPS.';return}if(!healer.value&&dps.value){st.textContent=P[tank.value].name+' and '+P[dps.value].name+' selected. Choose a healer.';return}const arm=[P[tank.value].armor,P[healer.value].armor,P[dps.value].armor];if(new Set(arm).size!==3){st.classList.add('bad');st.textContent='Invalid: armor types overlap.';return}st.classList.add('good');st.textContent='Valid composition with three different armor types.';showResult(tank.value,healer.value,dps.value)}
tank.addEventListener('change',()=>{healer.value='';dps.value='';dropdowns();update()});healer.addEventListener('change',()=>{dropdowns();update()});dps.addEventListener('change',()=>{dropdowns();update()});$('resetButton').addEventListener('click',()=>{tank.value='';healer.value='';dps.value='';dropdowns();update()});$('randomButton').addEventListener('click',()=>{const all=[];roles.Tank.forEach(t=>roles.Healer.forEach(h=>roles.DPS.forEach(d=>{if(new Set([P[t].armor,P[h].armor,P[d].armor]).size===3)all.push({t,h,d})})));const x=all[Math.floor(Math.random()*all.length)];tank.value=x.t;dropdowns();healer.value=x.h;dropdowns();dps.value=x.d;update()});
fill(tank,roles.Tank,'Select Tank','');dropdowns();update();
})();
</script>
</body>
</html>
